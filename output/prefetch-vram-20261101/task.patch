+def _worker(layer, fields="required", schedule="opportunity"):
+    worker = _make_worker({"probe": layer}, 16)
+    worker._summary_fields = fields
+    worker._method = "mean"
+    worker._scoring_schedule = schedule
+    worker._scoring_mode = "synchronous"
