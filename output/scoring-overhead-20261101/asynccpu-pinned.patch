+    @torch.no_grad()
+    def _copy_to_owned_cpu(self, source):
+        if not source.is_cuda:
+            return source.detach().to(device="cpu", copy=True)
+        # The CUDA caching host allocator can reuse these owned pinned buffers.
+        # Cooperative event waiting avoids a blocking D2H copy's driver wait.
+        owned = torch.empty(source.shape, dtype=source.dtype, device="cpu",
+                            pin_memory=True)
+        producer = torch.cuda.current_stream(source.device)
+        try:
+            owned.copy_(source, non_blocking=True)
+            completed = torch.cuda.Event()
+            completed.record(producer)
+            from semantic_offload.async_scoring import wait_for_owned_fence
+            wait_for_owned_fence(completed)
+        except BaseException:
+            # The CPU destination and GPU source must remain live until DMA
+            # stops, including copy/event-record/query failures. Fence INSIDE
+            # this frame rather than relying on the outer scoring-stream catch.
+            producer.synchronize()
+            raise
+        return owned
