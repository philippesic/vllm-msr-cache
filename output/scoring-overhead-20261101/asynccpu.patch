+    def _async_cpu_mean_bank(self, packed):
+        # setdefault publishes one lock even for __new__ CPU fixtures. Each
+        # immutable CPU bank has one backing allocation; concurrent jobs retain
+        # local references when a newer bank replaces the cache.
+        lock = self.__dict__.setdefault("_async_cpu_cache_lock", Lock())
+        with lock:
+            previous = getattr(self, "_async_cpu_bank", None)
+            if previous is not None and previous[0]() is packed:
+                return previous[1]
+            with torch.no_grad():
+                owned = packed.detach().to(device="cpu", copy=True)
+            current = getattr(self, "_async_packed_bank", None)
+            if current is not None and current[1] is packed:
+                # Weak identity avoids retaining another GPU bank as metadata.
+                self._async_cpu_bank = (weakref.ref(packed), owned)
+            return owned
