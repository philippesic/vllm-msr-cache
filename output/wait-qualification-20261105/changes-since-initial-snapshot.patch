+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--spec',type=Path)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--verify',action='store_true')
+    args=p.parse_args()
+    if args.verify:
