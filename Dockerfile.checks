FROM python:3.12.3-bookworm@sha256:25dee7f137aa44c4962d21346385737eb81954b6f06f519fcc348b67f6483d3c
WORKDIR /workspace
COPY tools/bootstrap-uv.txt tools/bootstrap-uv.txt
RUN python -m pip install --no-cache-dir --require-hashes -r tools/bootstrap-uv.txt
COPY . .
RUN uv sync --locked
CMD ["uv", "run", "--locked", "python", "tools/check.py", "--full"]
