+def _repack_awq_weight_rows(
+    qw: torch.Tensor,
+    size_bits: int,
+    chunk_rows: int = 0,
+) -> torch.Tensor:
+    """Repack 4-bit int32 weights, bounding unpacked storage by row count.
+
+    Chunk boundaries align with the destination packing axis. Each output word
+    therefore uses the same source values, bit order and int32 reduction as the
+    whole-matrix conversion. This runs only while loading model weights.
+    """
+    if size_bits != 4 or qw.dtype != torch.int32 or qw.ndim != 2:
+        raise ValueError("Bounded AWQ repacking requires 4-bit weights in a 2D int32 tensor")
+    pack_factor = 32 // size_bits
+    if qw.shape[0] % pack_factor:
+        raise ValueError("AWQ repack input rows must be a packing multiple")
+    if chunk_rows < 0 or (chunk_rows and chunk_rows % pack_factor):
+        raise ValueError("AWQ repack chunk rows must be zero or a positive packing multiple")
+    K, N_packed = qw.shape
+    N = N_packed * pack_factor
+    reverse_order = torch.tensor(
+        _REVERSE_AWQ_PACK_ORDER, dtype=torch.long, device=qw.device
+    )
+    shifts = torch.arange(0, 32, size_bits, dtype=torch.int32, device=qw.device)
+    mask = (1 << size_bits) - 1
+
+    def convert(rows: torch.Tensor) -> torch.Tensor:
+        unpacked = (rows.unsqueeze(-1) >> shifts) & mask
+        unpacked = unpacked[:, :, reverse_order]
+        unpacked = unpacked.reshape(rows.shape[0] // pack_factor, pack_factor, N)
+        return (unpacked.to(torch.int32) << shifts[None, :, None]).sum(
+            dim=1, dtype=torch.int32
+        )
+
+    if not chunk_rows or chunk_rows >= K:
+        return convert(qw)
+    packed = torch.empty((K // pack_factor, N), dtype=torch.int32, device=qw.device)
+    for start in range(0, K, chunk_rows):
+        end = min(start + chunk_rows, K)
+        packed[start // pack_factor : end // pack_factor] = convert(qw[start:end])
+    return packed
+
