  "content": "<!doctype html><html><head><style>body{margin:0;color:var(--foreground);font-family:var(--font-sans)}h3{font-size:17px;margin:4px 0 7px}p{font-size:13px;line-height:1.45;margin:6px 0;color:var(--muted-foreground)}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}button{font:inherit;font-size:12px;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius);color:var(--foreground);background:var(--secondary);cursor:pointer}button[aria-pressed=true]{background:var(--primary);color:var(--primary-foreground)}.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.box{padding:16px;border-radius:var(--radius);background:var(--card)}.big{font-size:27px;font-weight:650}.caption{font-size:12px;color:var(--muted-foreground)}svg{width:100%;height:175px}svg text{font-family:var(--font-sans);fill:var(--foreground);font-size:11px}.note{padding:10px 0;font-size:13px}.facts{font-size:12px;line-height:1.6;color:var(--muted-foreground)}</style></head><body><h3>Qualified for controlled asynchronous, human-reviewed draft queues</h3><p>Fresh natural generation · exact measured runtime/source snapshot · lead and independent Astra agree on this limited use.</p><div class=\"tabs\"><button data-key=\"candidate_vs_native8\" aria-pressed=\"true\">Matched native priority</button><button data-key=\"candidate_vs_native0\" aria-pressed=\"false\">Native with zero credit</button></div><div class=\"row\"><div class=\"box\"><div class=\"caption\">Output throughput</div><div class=\"big\" id=\"rate\"></div><div class=\"caption\" id=\"rateCI\"></div><p>Throughput/GiB changes by the same amount. VRAM is unchanged.</p></div><div class=\"box\"><div class=\"caption\">Mean first-token latency benefit</div><div class=\"big\" id=\"mean\"></div><div class=\"caption\" id=\"meanCI\"></div><p id=\"cold\"></p></div></div><svg id=\"latencies\" viewBox=\"0 0 640 175\" role=\"img\" aria-label=\"Paired latency differences and95percent intervals; negative values are lower latency\"></svg><p id=\"p95note\"></p><div class=\"facts\"><b>Verification:</b>2,592 fresh-confirmation responses;5,328 operational +16health completions; two exact abort/recovery checks. Original two abort-matcher failures remain recorded.<br><b>Operating limits:</b>finite waves, default registry lifetime4096, human review, bounded queues. Overlapping bursts reached49s first-token and64.6s end-to-end. Concurrent telemetry edits and the new vendored launcher are outside this qualification.<br>Nominal paired95% intervals are conditional on three fixed fresh traces, four repetitions each. No generic model-quality or indefinite-serving guarantee.</div><script>const data={\"candidate_vs_native8\": {\"label\": \"Matched native priority\", \"rate\": {\"mean\": 6.101969200825189, \"lower95\": 3.3354252683366106, \"upper95\": 8.942580330603702}, \"mean\": {\"mean\": -484.9306966874999, \"lower95\": -676.6955401187581, \"upper95\": -293.1658532562417}, \"p95\": {\"mean\": -923.6756564166666, \"lower95\": -2026.9609256893436, \"upper95\": 179.60961285601059}, \"cold\": {\"mean\": 0.19774707499967312, \"lower95\": -275.32688663999943, \"upper95\": 275.72238078999874}}, \"candidate_vs_native0\": {\"label\": \"Native with zero credit\", \"rate\": {\"mean\": 11.174817396415783, \"lower95\": 8.431557777860418, \"upper95\": 13.9874799958839}, \"mean\": {\"mean\": -1378.9406243055555, \"lower95\": -1615.3270241327464, \"upper95\": -1142.5542244783646}, \"p95\": {\"mean\": -1751.8508559291668, \"lower95\": -2007.0837907345283, \"upper95\": -1496.6179211238052}, \"cold\": {\"mean\": 3694.4983841375, \"lower95\": 2940.565073090358, \"upper95\": 4448.431695184642}}};const $=id=>document.getElementById(id);const ns='http://www.w3.org/2000/svg';function line(svg,x1,y1,x2,y2,color,width=2){const n=document.createElementNS(ns,'line');for(const [k,v]of Object.entries({x1,y1,x2,y2,stroke:color,'stroke-width':width}))n.setAttribute(k,v);svg.appendChild(n)}function text(svg,x,y,s){const n=document.createElementNS(ns,'text');n.setAttribute('x',x);n.setAttribute('y',y);n.textContent=s;svg.appendChild(n)}function plot(key){const d=data[key];for(const b of document.querySelectorAll('button'))b.setAttribute('aria-pressed',b.dataset.key===key);$('rate').textContent='+'+d.rate.mean.toFixed(2)+'%';$('rateCI').textContent='95% interval +'+d.rate.lower95.toFixed(2)+'% to +'+d.rate.upper95.toFixed(2)+'%';$('mean').textContent=Math.round(-d.mean.mean)+' ms';$('meanCI').textContent='lower mean first-token latency';$('cold').textContent=key==='candidate_vs_native8'?'Initial p95 roughly unchanged versus the same priority.':'Initial p95 +'+(d.cold.mean/1000).toFixed(2)+' s versus zero credit; generic scheduling contributes to this comparison.';const s=$('latencies');s.replaceChildren();const lo=key==='candidate_vs_native8'?-2400:-3000,hi=key==='candidate_vs_native8'?600:600;const scale=v=>130+(v-lo)/(hi-lo)*450;line(s,scale(0),14,scale(0),128,'var(--border)',1);text(s,130,155,'← lower latency');text(s,475,155,'higher →');for(const [i,k,label]of [[0,'mean','Mean TTFT'],[1,'p95','p95 TTFT']]){const a=d[k],y=40+i*60,c=k==='p95'&&a.upper95>0?'var(--muted-foreground)':'var(--chart-1)';text(s,3,y+4,label);line(s,scale(a.lower95),y,scale(a.upper95),y,c,3);line(s,scale(a.lower95),y-6,scale(a.lower95),y+6,c);line(s,scale(a.upper95),y-6,scale(a.upper95),y+6,c);const circle=document.createElementNS(ns,'circle');circle.setAttribute('cx',scale(a.mean));circle.setAttribute('cy',y);circle.setAttribute('r',5);circle.setAttribute('fill',c);s.appendChild(circle);text(s,130,y+23,Math.round(a.mean)+' ms ['+Math.round(a.lower95)+', '+Math.round(a.upper95)+']')} $('p95note').textContent=key==='candidate_vs_native8'?'Primary p95 interval crosses zero: no reliable improvement established.':'Total comparison includes return-priority gains and costs; it does not isolate the extension.'}document.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>plot(b.dataset.key)));plot('candidate_vs_native8');</script></body></html>"
}
